# Copy to docker/.env.prod and fill values before: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=mental_journal
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mental_journal

WEB_PORT=3000
API_PORT=3001

# Public URLs (browser). Use your domain or public EC2 IP.
# Example: http://12.34.56.78:3000  or  https://app.example.com
FRONTEND_URL=http://YOUR_PUBLIC_HOST:3000

# Socket.IO from the browser (API port until you put Nginx in front)
NEXT_PUBLIC_WS_URL=http://YOUR_PUBLIC_HOST:3001

# --- API secrets / config (also loaded into the api container) ---
JWT_ACCESS_SECRET=change_me_long_random
ACCESS_TOKEN_TTL=15m
SESSION_REFRESH_TTL=7d
EMAIL_TTL=24h

RESEND_API_KEY=
MAIL_FROM=

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
FALLBACK_LANGUAGE=pl

OPENAI_API_KEY=

SHADOWBAN_EXPIRY_CRON=0 0 * * *
SHADOWBAN_TIME_ZONE=Europe/Warsaw

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
