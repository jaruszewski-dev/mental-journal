# Copy to docker/.env.prod and fill values before:
# docker compose -f docker/docker-compose.prod.yml --env-file docker/.env.prod up -d --build

POSTGRES_USER=mental_journal
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=mental_journal

# Host port for Nginx (default 80)
HTTP_PORT=80

# Public URLs (browser) — through Nginx, no :3000 / :3001
# Example: http://12.34.56.78  or  https://app.example.com
FRONTEND_URL=http://YOUR_PUBLIC_HOST
NEXT_PUBLIC_WS_URL=http://YOUR_PUBLIC_HOST

# --- API secrets / config ---
JWT_ACCESS_SECRET=change_me_long_random
ACCESS_TOKEN_TTL=15m
SESSION_REFRESH_TTL=7d
EMAIL_TTL=24h

RESEND_API_KEY=
MAIL_FROM=

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
FALLBACK_LANGUAGE=pl

OPENAI_API_KEY=

SHADOWBAN_EXPIRY_CRON=0 0 * * *
SHADOWBAN_TIME_ZONE=Europe/Warsaw

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_S3_API_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
