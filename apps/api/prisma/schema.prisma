// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
  SHADOWBANNED
}

enum UserRole {
  ADMIN
  USER
  MODERATOR
}

enum EntryStatus {
  ACTIVE
  HIDDEN
}

enum PostStatus {
  PENDING
  ACTIVE
  HIDDEN
}

enum CommentStatus {
  PENDING
  ACTIVE
  HIDDEN
}

enum ModerationCaseStatus {
  OPEN
  BANNED
  DISMISSED
  EXPIRED
}

enum ModerationCaseTrigger {
  TRUST_THRESHOLD
  SHADOWBAN_REPEAT_BLOCK
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  anonName String @map("anon_name")

  status UserStatus @default(ACTIVE)
  role   UserRole   @default(USER)

  trustScore Int @default(0) @map("trust_score")

  email        String @unique
  passwordHash String @map("password_hash")

  emailVerified                   Boolean   @default(false) @map("email_verified")
  emailVerificationTokenHash      String?   @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime? @map("email_verification_token_expires_at")

  bannedAt          DateTime? @map("banned_at")
  bannedReason      String?   @map("banned_reason")
  shadowBannedUntil DateTime? @map("shadow_banned_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session        Session[]
  journalEntries JournalEntry[]
  posts          Post[]
  comments       Comment[]

  moderationCases         ModerationCase[] @relation("ModerationCaseSubject")
  resolvedModerationCases ModerationCase[] @relation("ModerationCaseResolver")

  @@map("user")
}

model Session {
  id     String @id @default(uuid())
  userId String @map("user_id")

  refreshTokenHash String @unique @map("refresh_token_hash")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model JournalEntry {
  id     String @id @default(uuid())
  userId String @map("user_id")

  content String
  mood    Int?
  tags    String[] @default([])

  status EntryStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  post Post?

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model Post {
  id             String @id @default(uuid())
  authorId       String @map("author_id")
  journalEntryId String @unique @map("journal_entry_id")

  content String
  mood    Int?
  tags    String[] @default([])

  status PostStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  author             User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  journalEntry       JournalEntry         @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  comments           Comment[]
  moderationEvidence ModerationEvidence[]

  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id       String @id @default(uuid())
  postId   String @map("post_id")
  authorId String @map("author_id")

  content String
  status  CommentStatus @default(PENDING)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post               Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  author             User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moderationEvidence ModerationEvidence[]

  @@index([postId, createdAt])
  @@map("comments")
}

model ModerationCase {
  id     String @id @default(uuid())
  userId String @map("user_id")

  status  ModerationCaseStatus  @default(OPEN)
  trigger ModerationCaseTrigger
  reason  String

  trustScoreSnapshot Int @map("trust_score_snapshot")

  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")

  resolvedById   String? @map("resolved_by_id")
  resolutionNote String? @map("resolution_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                 @relation("ModerationCaseSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?                @relation("ModerationCaseResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  evidence   ModerationEvidence[]

  @@index([status, openedAt])
  @@index([userId, openedAt])
  @@map("moderation_cases")
}

model ModerationEvidence {
  id     String @id @default(uuid())
  caseId String @map("case_id")

  postId    String? @map("post_id")
  commentId String? @map("comment_id")

  contentSnapshot String? @map("content_snapshot")
  aiReason        String? @map("ai_reason")

  createdAt DateTime @default(now()) @map("created_at")

  case    ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  post    Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment Comment?       @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("moderation_evidence")
}
