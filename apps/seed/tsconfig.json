{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Node",
		"outDir": "./dist",
		"declaration": false,
		"declarationMap": false,
		"lib": ["ES2022"],
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
